# Server Configuration
PORT=8080
PUBLIC_BASE_URL=https://api.yourdomain.com

# PostgreSQL / Supabase Connection (TLS required in production)
DATABASE_URL=postgres://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT & Session Security
JWT_SECRET=replace_with_a_64_char_cryptographically_random_secret_key_here
ACCESS_TOKEN_TTL_MINUTES=15

# Hoppscotch Admin Access
# X-Admin-API-Key allows direct admin management from Hoppscotch without a device JWT
ADMIN_MASTER_KEY=replace_with_strong_hoppscotch_master_admin_api_key
# Optional additional header secret when using Admin JWTs
ADMIN_SECRET=

# Firebase Authentication
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
# Set DEV_BYPASS_FIREBASE=true only in local testing when passing "dev_phone:+919876543210" as firebase_id_token
DEV_BYPASS_FIREBASE=false

# Local directory where uploaded APK releases are stored and streamed from
APK_STORAGE_DIR=./storage/apks