# =============================================================================
# STOCK HABRON SQL SERVER -> SUPABASE POSTGRESQL INTEGRATOR WORKER (.env.example)
# =============================================================================

# 1. Habron SQL Server Read-Only Connection (ApplicationIntent=ReadOnly enforced)
HABRON_MSSQL_DSN=sqlserver://readonly_user:readonly_password@localhost:1433?database=HabronPOS&ApplicationIntent=ReadOnly&encrypt=disable

# Optional custom SQL view/table name in Habron SQL Server exposing ready-to-store product+stock rows
HABRON_SOURCE_VIEW=vw_PoshakReadyStockInventory

# 2. Target Supabase PostgreSQL Connection (TLS required)
SUPABASE_DATABASE_URL=postgres://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 3. Sync & Reconciliation Tuning
# Interval between incremental sync cycles (e.g. 30s, 1m, 2m)
SYNC_POLL_INTERVAL=30s

# Interval between full snapshot reconciliations to detect hard-deleted Habron rows & prune stale lookups (e.g. 30m, 1h)
FULL_RECONCILE_INTERVAL=30m

# Number of products/stock rows per PostgreSQL batch upsert transaction
BATCH_SIZE=500

# Windows Service Name
WINDOWS_SERVICE_NAME=PoshakStockHabronIntegrator
